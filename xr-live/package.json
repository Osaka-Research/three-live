{
  "name": "xr-live",
  "version": "1.0.0",
  "description": "HTML-First Spatial Computing, 6DoF WebXR, Hand Gestures, and AI-Driven XR on top of three-live",
  "author": "Google LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/three-live.git",
    "directory": "xr-live"
  },
  "homepage": "https://google.github.io/three-live/",
  "bugs": {
    "url": "https://github.com/google/three-live/issues"
  },
  "files": [
    "dist"
  ],
  "main": "dist/xr-live.cjs",
  "module": "dist/xr-live.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "dist/*.js",
    "dist/*.cjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/xr-live.js",
      "require": "./dist/xr-live.cjs"
    },
    "./blocks": {
      "types": "./dist/xr-live-blocks.d.ts",
      "import": "./dist/xr-live-blocks.js",
      "require": "./dist/xr-live-blocks.cjs"
    }
  },
  "dependencies": {
    "three-live": "1.0.0"
  },
  "scripts": {
    "prepack": "node -e \"require('fs').copyFileSync('../LICENSE', 'LICENSE')\"",
    "build": "node ../scripts/build.js --xr-live",
    "test": "node ../scripts/build.js --test-xr-live"
  }
}
