{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.google/three-live",
  "title": "Three-Live 3D, CAD & Spatial XR Compiler",
  "description": "Compile, lint, simulate (60 Hz), and render headless 4-up 3D contact sheets from Three.js to GLB, USDZ, Android XR, and iOS RealityKit.",
  "repository": {
    "url": "https://github.com/google/three-live",
    "source": "github"
  },
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "three-live",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
